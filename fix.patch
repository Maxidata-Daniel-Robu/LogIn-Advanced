@@ -0,0 +1,36 @@
+@page "/register"
+@inject HttpClient Http
+@inject NavigationManager Nav
+
+<h3>Register</h3>
+
+@if (!string.IsNullOrEmpty(statusMessage))
+{
+    <div>@statusMessage</div>
+}
+
+<EditForm Model="@user" OnValidSubmit="HandleRegister">
+    <InputText @bind-Value="user.Username" placeholder="Username" />
+    <InputText @bind-Value="user.Password" placeholder="Password" type="password" />
+    <InputText @bind-Value="user.Description" placeholder="Description" />
+    <button type="submit">Register</button>
+</EditForm>
+
+@code {
+    private UserModel user = new();
+    private string? statusMessage;
+
+    private async Task HandleRegister()
+    {
+        var response = await Http.PostAsJsonAsync("users", user);
+        if (response.IsSuccessStatusCode)
+        {
+            statusMessage = "User registered.";
+            Nav.NavigateTo("login", true);
+        }
+        else
+        {
+            statusMessage = "Registration failed.";
+        }
+    }
+}

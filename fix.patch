diff --git a/BlazorFrontend/Pages/Login.razor b/BlazorFrontend/Pages/Login.razor
new file mode 100644
index 0000000000000000000000000000000000000000..55fe472de5e65f24ae9b0569d9b84bf43973d7b3
--- /dev/null
+++ b/BlazorFrontend/Pages/Login.razor
@@ -0,0 +1,41 @@
+@page "/login"
+@inject HttpClient Http
+@inject NavigationManager Nav
+
+<h3>Login</h3>
+
+@if (!string.IsNullOrEmpty(statusMessage))
+{
+    <div>@statusMessage</div>
+}
+
+<EditForm Model="@user" OnValidSubmit="HandleLogin">
+    <InputText @bind-Value="user.Username" placeholder="Username" />
+    <InputText @bind-Value="user.Password" placeholder="Password" type="password" />
+    <button type="submit">Login</button>
+</EditForm>
+
+@code {
+    private UserModel user = new();
+    private string? statusMessage;
+
+    private class LoginResponse
+    {
+        public bool success { get; set; }
+    }
+
+    private async Task HandleLogin()
+    {
+        var response = await Http.PostAsJsonAsync("login", user);
+        var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
+        if (result?.success == true)
+        {
+            statusMessage = "Login successful.";
+            Nav.NavigateTo("/", true);
+        }
+        else
+        {
+            statusMessage = "Invalid credentials.";
+        }
+    }
+}
diff --git a/BlazorFrontend/Pages/Register.razor b/BlazorFrontend/Pages/Register.razor
